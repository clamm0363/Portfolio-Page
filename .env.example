# Cloudflare Tunnel Token
# Create at: Cloudflare Zero Trust → Networks → Tunnels → Create a tunnel
# Copy the token from the tunnel configuration
TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# PostgreSQL Database Configuration
POSTGRES_DB=umami
POSTGRES_USER=umami
POSTGRES_PASSWORD=your-secure-password-here

# Umami Hash Salt (generate a random string with: openssl rand -hex 32)
UMAMI_HASH_SALT=your-random-64-character-hex-string-here

# Portainer API Token (daily Nginx-only updates; use an EXISTING credential)
# Create at: Portainer → My account → API keys
# Never pass the token as a command-line argument.
PORTAINER_API_TOKEN=ptr_your_portainer_token_here

# Portainer URL (required; use the verified existing management URL)
PORTAINER_URL=https://portainer.example.invalid

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. For daily publication only PORTAINER_URL and PORTAINER_API_TOKEN are used.
# 3. Preserve existing DB/Tunnel settings; do not rotate or recreate them here.
# 4. The DB/Tunnel placeholders above describe the historical full-stack file.
# 5. Never deploy that file to the current environment without reconciliation.
# 6. Never commit .env to git. See DEPLOYMENT.md for local target configuration.
